# Minimal image for DockerExecutor: only what generated code is allowed to use.
# Run with --network none --read-only --cap-drop ALL --user 1000:1000 (see sandbox/executor.py)
FROM python:3.12-slim
RUN pip install --no-cache-dir "pandas>=2.2" "numpy>=1.26" "pyarrow>=15" \
    && useradd --uid 1000 --create-home sandbox
USER 1000:1000
WORKDIR /job
