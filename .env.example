# Planner: heuristic (offline, default) | anthropic[:model] | openai[:model] | ollama[:model]
WRANGLER_LLM=heuristic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where checkpoints, memory and sandbox files live
WRANGLER_HOME=.wrangler
WRANGLER_SAMPLE_SIZE=5000
WRANGLER_MAX_ATTEMPTS=3
WRANGLER_MAX_NEW_NULLS=0.02
WRANGLER_MIN_CONFIDENCE=0.6
WRANGLER_OUTPUT_PREFIX=clean_
